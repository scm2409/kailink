<?xml version="1.0" encoding="utf-8"?>
<!-- NUR emulatorDebug (E2E-Test-Infrastruktur): Klartext-HTTP zum lokalen
     Matrix-Homeserver (Conduit :6167) und Push-Gateway (ntfy :8090).
     Release/debug bleiben unangetastet (Default: kein Cleartext). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.42.20</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
